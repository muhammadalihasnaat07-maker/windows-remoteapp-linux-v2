# Windows RemoteApp Linux v2
#
# setup.sh will use this as a template and create:
#   ~/WinApps/.env
#
# Never commit the generated .env file.

WINAPPS_IMAGE=ghcr.io/dockur/windows:latest

WINDOWS_VERSION=10
WINDOWS_RAM=6G
WINDOWS_CPUS=4
WINDOWS_DISK=40G

WINDOWS_USERNAME=WinApps
WINDOWS_PASSWORD=ChangeThisPassword

# Dedicated host folder exposed to Windows.
# setup.sh will create this automatically.
WINAPPS_SHARED_DIR=${HOME}/WinApps/shared
